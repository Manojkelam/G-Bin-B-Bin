# Supabase Configuration
# Replace with your Supabase Project URL and Public Anon Key
# In local development with Supabase CLI (npx supabase start):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon key from `npx supabase status`>

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
